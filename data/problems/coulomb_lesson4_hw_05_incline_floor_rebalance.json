  "title": "A5：斜面与水平面双球",
  "type": "multiple-choice",
  "question": "带电小球 A、B 分别在光滑斜面和水平面。将 B 向左移动，A 沿斜面上移后重新平衡，比较支持力、推力和距离。",
  "options": [
    "A. 斜面对 A 的弹力增大",
    "B. 水平面对 B 的弹力增大",
    "C. 推力 F 变小",
    "D. 两球距离变小"
  ],
  "answer": "BC",
  "analysis": {
    "title": "解析",
    "sharedThinking": "用 A 的三力平衡矢量三角形判断库仑力与斜面支持力，再对整体列竖直平衡。",
    "sharedFormula": "\\[F=F_e\\cos\\theta_e,\\qquad N_B+N_A\\cos\\alpha=(m_A+m_B)g\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "用 A 的三力平衡矢量三角形判断库仑力与斜面支持力，再对整体列竖直平衡。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[F=F_e\\cos\\theta_e,\\qquad N_B+N_A\\cos\\alpha=(m_A+m_B)g\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "A 上移后库仑力与斜面支持力均减小，故球距增大；A 支持力竖直分量减小，使 B 支持力增大；库仑力减小且方向更偏离水平，推力减小。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **BC**。"
    }
  ],
