{
  "id": "electric_potential_lesson78_hw_05_lightning_field",
  "chapter": "电势、电势差与等势面",
  "title": "单5：积雨云与避雷针电场",
  "type": "single-choice",
  "question": "积雨云上正下负，地面感应正电。图示P、M、N在同一弯曲场线上且PM=MN。",
  "options": [
    "A. EP<EM<EN",
    "B. UPM>UMN",
    "C. 电子在P点电势能大于在N点",
    "D. 放电电流由云层指向建筑物"
  ],
  "answer": "B",
  "analysis": {
    "title": "解析",
    "sharedThinking": "由场线疏密比较场强；等长线段上的电势差是场强沿路径积分；区分电子流与约定电流。",
    "sharedFormula": "\\[U_{AB}=\\int_A^B\\vec E\\cdot d\\vec l\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "由场线疏密比较场强；等长线段上的电势差是场强沿路径积分；区分电子流与约定电流。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[U_{AB}=\\int_A^B\\vec E\\cdot d\\vec l\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "越靠近建筑物尖端场线越密，故EP>EM>EN。PM与MN等长但前段平均场强更大，所以UPM>UMN。P电势高于N，电子在P势能更低；约定电流方向与电子运动相反。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **B**。"
    }
  ],
