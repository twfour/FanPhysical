{
  "id": "coulomb_lesson4_course_08_box_cut_string",
  "chapter": "电荷守恒定律与库仑定律",
  "title": "例8：木盒内双球断绳",
  "type": "multiple-choice",
  "question": "木盒内异号小球 A、B 分别由两根竖直细绳约束。静止时地面压力为 F_N，B 绳张力为 F。剪断 B 绳，判断木盒压力。",
  "options": [
    "A. 刚剪断仍为 F_N",
    "B. 刚剪断为 F_N+F",
    "C. 刚剪断为 F_N-F",
    "D. B 向上运动过程中木盒压力逐渐增大"
  ],
  "answer": "BD",
  "analysis": {
    "title": "解析",
    "sharedThinking": "先分别写两球平衡，再比较剪断前后绳对木盒的竖直作用。",
    "sharedFormula": "\\[F_e=mg+F,\\qquad T_A=mg+F_e\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "先分别写两球平衡，再比较剪断前后绳对木盒的竖直作用。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[F_e=mg+F,\\qquad T_A=mg+F_e\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "剪断前 B 绳对盒有向上的 F；剪断瞬间该作用消失，而 A 绳张力尚未改变，所以压力增大 F。B 上升时球间距减小、吸引力和 A 绳张力增大，压力继续增大。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **BD**。"
    }
  ],
