      "stepId": 2,
      "title": "对应公式",
      "content": "\\[F_{\\rm point}=k\\frac{q_1q_2}{(3R)^2}\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "导体上的电荷可以重新分布。异号电荷在相对侧更密集，使近距离电荷之间的吸引贡献增强，因此实际吸引力大于球心点电荷近似值。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **B**。"
    }
