  "type": "calculation",
  "question": "点电荷 \\(q=1.0\\times10^{-8}C\\) 在 A 点受力 \\(2.0\\times10^{-5}N\\)。从 A 移到零电势 O 点，电场力做功 \\(2.0\\times10^{-6}J\\)。求 A 点场强、\\(U_{AO}\\)、A 点电势和电势能。",
  "options": null,
  "answer": "\\(E_A=2.0\\times10^3N/C\\)，\\(U_{AO}=\\varphi_A=200V\\)，\\(E_{pA}=2.0\\times10^{-6}J\\)",
  "analysis": {
    "title": "解析",
    "sharedThinking": "依次使用场强定义、电场力功和电势能定义。",
    "sharedFormula": "\\[E=F/q,\\quad W=qU_{AO},\\quad E_p=q\\varphi\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "shared-solution"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "依次使用场强定义、电场力功和电势能定义。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[E=F/q,\\quad W=qU_{AO},\\quad E_p=q\\varphi\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "代入可得 E=2000N/C；U_AO=W/q=200V。O为零电势，故φA=200V，EpA=qφA=2.0×10^-6J。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **\\(E_A=2.0\\times10^3N/C\\)，\\(U_{AO}=\\varphi_A=200V\\)，\\(E_{pA}=2.0\\times10^{-6}J\\)**。"
    }
  ],
