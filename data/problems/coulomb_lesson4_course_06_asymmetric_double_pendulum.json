  "type": "single-choice",
  "question": "带电小球 A、B 用等长 L 的丝线悬于 O 点，平衡距离为 d。要使距离变为 d/2，可采用哪种方法？",
  "options": [
    "A. A、B 质量都变为2倍",
    "B. B 的质量变为8倍",
    "C. A、B 电荷量都减半",
    "D. A、B 电荷量都减半且 B 质量变为4倍"
  ],
  "answer": "B",
  "analysis": {
    "title": "解析",
    "sharedThinking": "由 B 球沿切线方向平衡，结合弦长与半角关系得到距离的三次方标度。",
    "sharedFormula": "\\[d^3\\propto\\frac{Q_AQ_B}{m_B}\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
