  "title": "单3：细胞膜钠离子减速",
  "type": "single-choice",
  "question": "初速度 v0 的正一价钠离子仅受膜内匀强电场力，从膜外 A 点刚好运动到膜内 B 点。A点电势φA，质量m，电荷e，膜厚d。",
  "options": [
    "A. \\(a=v_0^2/d\\)",
    "B. \\(E=mv_0^2/(ed)\\)",
    "C. \\(\\varphi_B=\\varphi_A+mv_0^2/e\\)",
    "D. \\(E_{pB}=e\\varphi_A+mv_0^2/2\\)"
  ],
  "answer": "D",
  "analysis": {
    "title": "解析",
    "sharedThinking": "由末速度为零的匀减速运动求加速度，再用动能定理和能量守恒求场强与电势。",
    "sharedFormula": "\\[0-v_0^2=-2ad,\\qquad e(\\varphi_A-\\varphi_B)=-\\frac12mv_0^2\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "由末速度为零的匀减速运动求加速度，再用动能定理和能量守恒求场强与电势。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[0-v_0^2=-2ad,\\qquad e(\\varphi_A-\\varphi_B)=-\\frac12mv_0^2\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "得到 \\(a=v_0^2/(2d)\\)、\\(E=mv_0^2/(2ed)\\)、\\(\\varphi_B=\\varphi_A+mv_0^2/(2e)\\)，从而 \\(E_{pB}=e\\varphi_A+mv_0^2/2\\)。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **D**。"
    }
  ],
