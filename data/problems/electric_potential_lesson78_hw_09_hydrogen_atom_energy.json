  "title": "多9：氢原子经典模型",
  "type": "multiple-choice",
  "question": "电子绕氢原子核做半径r的匀速圆周运动，核电荷+e、电子-e，取无穷远电势为零。",
  "options": [
    "A. \\(v=e\\sqrt{k/(mr)}\\)",
    "B. \\(I=\\frac{e^2}{2\\pi r}\\sqrt{\\frac{k}{mr}}\\)",
    "C. 一周库仑力做功 \\(2\\pi ke^2/r\\)",
    "D. 总能量 \\(-ke^2/(2r)\\)"
  ],
  "answer": "ABD",
  "analysis": {
    "title": "解析",
    "sharedThinking": "库仑力提供向心力；等效电流为电荷量除以周期；圆周运动中向心力不做功。",
    "sharedFormula": "\\[\\frac{ke^2}{r^2}=\\frac{mv^2}{r},\\quad I=\\frac eT=\\frac{ev}{2\\pi r},\\quad E=\\frac12mv^2-\\frac{ke^2}{r}\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "库仑力提供向心力；等效电流为电荷量除以周期；圆周运动中向心力不做功。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[\\frac{ke^2}{r^2}=\\frac{mv^2}{r},\\quad I=\\frac eT=\\frac{ev}{2\\pi r},\\quad E=\\frac12mv^2-\\frac{ke^2}{r}\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "由向心方程得A；代入周期得B。库仑力始终垂直速度，一周做功为零。动能ke²/(2r)，势能-ke²/r，总能量为-ke²/(2r)。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **ABD**。"
    }
  ],
