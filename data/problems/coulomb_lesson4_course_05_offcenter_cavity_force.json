{
  "id": "coulomb_lesson4_course_05_offcenter_cavity_force",
  "chapter": "电荷守恒定律与库仑定律",
  "title": "例5：偏心球形空腔",
  "type": "calculation",
  "question": "半径 R 的绝缘介质球内均匀带总电荷 +Q。在右侧挖去半径 R/2、与外球面相切的球形空腔；点电荷 +q 位于球面外 R 处。求剩余带电体对 q 的作用力。",
  "options": null,
  "answer": "\\(F=\\frac{7kQq}{36R^2}\\)，方向水平向右",
  "analysis": {
    "title": "解析",
    "sharedThinking": "用“完整均匀带电球减去被挖小球”的叠加模型。",
    "sharedFormula": "\\[E=\\frac{kQ}{(2R)^2}-\\frac{k(Q/8)}{(3R/2)^2}\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "shared-solution"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "用“完整均匀带电球减去被挖小球”的叠加模型。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[E=\\frac{kQ}{(2R)^2}-\\frac{k(Q/8)}{(3R/2)^2}\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "小球体积是原球的 \\(1/8\\)，被挖电荷为 \\(Q/8\\)。点电荷到大球心距离 \\(2R\\)，到空腔球心距离 \\(3R/2\\)，故 \\(E=7kQ/(36R^2)\\)，乘 q 得结论。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **\\(F=\\frac{7kQq}{36R^2}\\)，方向水平向右**。"
    }
  ],
