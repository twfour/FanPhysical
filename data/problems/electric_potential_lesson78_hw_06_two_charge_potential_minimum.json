  "title": "单6：两电荷电势最低点",
  "type": "single-choice",
  "question": "点电荷M固定在x=-20cm、N在原点，x正半轴电势曲线过x0并在x=20cm取最小值。正电荷q从x0静止释放。",
  "options": [
    "A. M正、N负",
    "B. x0处场强为0",
    "C. |qM|:|qN|=4:1",
    "D. q向右运动时电势能先增大后减小"
  ],
  "answer": "C",
  "analysis": {
    "title": "解析",
    "sharedThinking": "电势曲线斜率为负场强；极小点斜率为零，并用两点电荷场强抵消求电荷量比。",
    "sharedFormula": "\\[E_x=-\\frac{d\\varphi}{dx},\\qquad \\frac{k|q_N|}{(0.20)^2}=\\frac{k|q_M|}{(0.40)^2}\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "电势曲线斜率为负场强；极小点斜率为零，并用两点电荷场强抵消求电荷量比。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[E_x=-\\frac{d\\varphi}{dx},\\qquad \\frac{k|q_N|}{(0.20)^2}=\\frac{k|q_M|}{(0.40)^2}\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "N处曲线趋正无穷，N为正；远处电势从负侧趋零，M为负且量值更大。x0只是零电势点而非零场强点。x=20cm场强为零，得到|qM|:|qN|=4:1。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **C**。"
    }
  ],
