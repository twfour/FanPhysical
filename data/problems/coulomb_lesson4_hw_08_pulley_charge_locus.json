  "type": "multiple-choice",
  "question": "O 正下方 h 处固定电荷 Q，带电球 B 经定滑轮牵引静止，AB=R。缓慢向下拉绳使 B 移动，判断重力、张力、距离与轨迹。",
  "options": [
    "A. \\(mg=kQqh/R^3\\)",
    "B. 绳张力先增大后减小",
    "C. A、B 距离不变",
    "D. B 的轨迹是一段圆弧"
  ],
  "answer": "ACD",
  "analysis": {
    "title": "解析",
    "sharedThinking": "对 B 水平、竖直分量消去张力，可得 AB 距离恒定；轨迹因此是以 A 为圆心的圆弧。",
    "sharedFormula": "\\[mg=\\frac{kQq}{r^2}\\frac{h}{r}=\\frac{kQqh}{r^3}\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
