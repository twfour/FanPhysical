  "title": "例10：墙地双球再平衡",
  "type": "single-choice",
  "question": "同种电荷小球 A、B 分别位于光滑竖直墙面和水平地面。把 B 向左推动少许并重新平衡，与原来相比如何？",
  "options": [
    "A. 两球间距变大",
    "B. B 所受推力变大",
    "C. A 对墙压力变大",
    "D. 地面对 B 支持力变大"
  ],
  "answer": "A",
  "analysis": {
    "title": "解析",
    "sharedThinking": "A 球竖直方向始终由库仑力分量平衡重力，结合图示几何分支判断新位置。",
    "sharedFormula": "\\[F_e\\frac{\\Delta y}{r}=m_Ag\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
  "steps": [
