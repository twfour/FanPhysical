  "title": "例4：异号双球接触分配",
  "type": "single-choice",
  "question": "相同金属球 A、B 带等量异号电荷，原吸引力为 F。不带电同样金属球 C 先接触 A、再接触 B 后移开，求 A、B 间作用力。",
  "options": [
    "A. F/8",
    "B. F/4",
    "C. 3F/8",
    "D. 3F/4"
  ],
  "answer": "A",
  "analysis": {
    "title": "解析",
    "sharedThinking": "相同金属球接触后平分两球总电荷，按接触顺序追踪 A、B、C 的电荷。",
    "sharedFormula": "\\[q_A'=\\frac q2,\\qquad q_B'=\\frac{-q+q/2}{2}=-\\frac q4\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "相同金属球接触后平分两球总电荷，按接触顺序追踪 A、B、C 的电荷。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[q_A'=\\frac q2,\\qquad q_B'=\\frac{-q+q/2}{2}=-\\frac q4\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "第一次接触后 A、C 各为 \\(q/2\\)；第二次 C 与 B 接触后，B、C 各为 \\(-q/4\\)。故 \\(F'=k|(q/2)(-q/4)|/r^2=F/8\\)。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **A**。"
    }
  ],
