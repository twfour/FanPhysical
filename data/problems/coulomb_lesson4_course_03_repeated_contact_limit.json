  "title": "例3：三球反复接触极限",
  "type": "calculation",
  "question": "相同金属球 A、B 初始带等量同号电荷，作用力为 F₀。不带电同样金属球 C 依次与 A、B、A……反复接触无穷次后移走，求 A、B 间作用力。",
  "options": null,
  "answer": "\\(F=\\frac49F_0\\)",
  "analysis": {
    "title": "解析",
    "sharedThinking": "每次接触后两相同金属球平分总电荷；反复过程的极限是三球电荷相等。",
    "sharedFormula": "\\[q'_A=q'_B=q'_C=\\frac{2q}{3},\\qquad F\\propto q_Aq_B\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "shared-solution"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "每次接触后两相同金属球平分总电荷；反复过程的极限是三球电荷相等。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[q'_A=q'_B=q'_C=\\frac{2q}{3},\\qquad F\\propto q_Aq_B\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "三球总电荷为 \\(2q\\) 且守恒。反复平均后极限状态三球各带 \\(2q/3\\)，移走 C 后 \\(F/F_0=(2/3)^2=4/9\\)。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **\\(F=\\frac49F_0\\)**。"
    }
  ],
