{
  "id": "electric_potential_lesson78_course_04_electron_vt_field",
  "chapter": "电势、电势差与等势面",
  "title": "例4：电子速度图与场强",
  "type": "single-choice",
  "question": "负电荷从电场线上的 A 点静止释放，仅受静电力运动到 B，速度随时间增加但斜率逐渐减小。判断 A、B 点场强、电势和电势能关系。",
  "options": [
    "A. \\(E_A>E_B,\\ \\varphi_A>\\varphi_B\\)",
    "B. \\(E_A<E_B,\\ \\varphi_A<\\varphi_B\\)",
    "C. \\(E_A>E_B,\\ E_{pA}>E_{pB}\\)",
    "D. \\(E_A<E_B,\\ E_{pA}<E_{pB}\\)"
  ],
  "answer": "C",
  "analysis": {
    "title": "解析",
    "sharedThinking": "v-t 图斜率给加速度，电子受力方向与场强方向相反；只有电场力做功时动能增加等于电势能减少。",
    "sharedFormula": "\\[a=\\frac{dv}{dt}=\\frac{eE}{m},\\qquad \\Delta E_k=-\\Delta E_p\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "v-t 图斜率给加速度，电子受力方向与场强方向相反；只有电场力做功时动能增加等于电势能减少。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[a=\\frac{dv}{dt}=\\frac{eE}{m},\\qquad \\Delta E_k=-\\Delta E_p\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "图像斜率逐渐减小，故 \\(E_A>E_B\\)。电子从 A 到 B 动能增加，所以电势能降低，即 \\(E_{pA}>E_{pB}\\)。电子沿受力方向、逆电场方向运动，故 \\(\\varphi_A<\\varphi_B\\)。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **C**。"
    }
  ],
