  "title": "单4：四电荷电势地形",
  "type": "single-choice",
  "question": "四个等量点电荷位于正方形顶点，给出xOy平面电势地形图，OA=OB=OC。判断场强与沿路径电势变化。",
  "options": [
    "A. A、B场强相同",
    "B. O点场强和电势均为零",
    "C. A到B电势先升高后降低",
    "D. 正电荷从O到C，电势能先增大后减小"
  ],
  "answer": "C",
  "analysis": {
    "title": "解析",
    "sharedThinking": "把地形高度视为电势，坡度方向和大小对应电场方向及大小；沿给定直线读取高度变化。",
    "sharedFormula": "\\[\\vec E=-\\nabla\\varphi,\\qquad E_p=q\\varphi\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "把地形高度视为电势，坡度方向和大小对应电场方向及大小；沿给定直线读取高度变化。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[\\vec E=-\\nabla\\varphi,\\qquad E_p=q\\varphi\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "A、B处地形坡度方向不同，场强不相同；O虽处零电势附近但坡度不为零。沿A到B的剖面先越过电势高处再下降，因此C正确；O到C的电势并非先升后降。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **C**。"
    }
  ],
