  "title": "例7：三电荷共线平衡",
  "type": "single-choice",
  "question": "光滑绝缘水平面上 A、B、C 三个带电小球沿直线排列并恰好平衡，哪组电荷可能实现？",
  "options": [
    "A. -9、+4、-36",
    "B. +4、+9、+36",
    "C. -3、+2、+8",
    "D. +3、-2、+6"
  ],
  "answer": "A",
  "analysis": {
    "title": "解析",
    "sharedThinking": "共线三球平衡要求两端同号、中间异号，并满足中间电荷量的特定关系。",
    "sharedFormula": "\\[|q_B|=\\frac{|q_Aq_C|}{(\\sqrt{|q_A|}+\\sqrt{|q_C|})^2}\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "共线三球平衡要求两端同号、中间异号，并满足中间电荷量的特定关系。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[|q_B|=\\frac{|q_Aq_C|}{(\\sqrt{|q_A|}+\\sqrt{|q_C|})^2}\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "A 中两端同为负，中间为正，且 \\(9\\times36/(3+6)^2=4\\)，满足平衡；其余选项违反电性或电荷量关系。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **A**。"
    }
  ],
