{
  "id": "electric_potential_lesson78_course_10_equal_potential_planes",
  "chapter": "电势、电势差与等势面",
  "title": "例10：等距等势面与电子",
  "type": "multiple-choice",
  "question": "匀强电场中等距等势面依次为 d、c、b、a。电子经过 d 时动能20eV，经过 c 时电势能-10eV，到 b 时速度为零。判断不正确项。",
  "options": [
    "A. a 的电势为 -20V",
    "B. 场强大小为 200V/m",
    "C. 电子经过 a 时电势能为 10eV",
    "D. 电子动能为26eV时，电势能为-26eV"
  ],
  "answer": "A",
  "analysis": {
    "title": "解析",
    "sharedThinking": "用总能量守恒和等距等势面的等电势差关系，先求相邻电势差，再逐项判断。",
    "sharedFormula": "\\[E_k+E_p=\\text{常量},\\qquad E=\\frac{|\\Delta\\varphi|}{\\Delta x}\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
  "steps": [
    {
      "stepId": 1,
      "title": "条件提取",
      "content": "用总能量守恒和等距等势面的等电势差关系，先求相邻电势差，再逐项判断。"
    },
    {
      "stepId": 2,
      "title": "对应公式",
      "content": "\\[E_k+E_p=\\text{常量},\\qquad E=\\frac{|\\Delta\\varphi|}{\\Delta x}\\]"
    },
    {
      "stepId": 3,
      "title": "推导过程",
      "content": "设相邻等势面电势差为 Δφ。联立 d、c、b 三个状态得 Δφ=-10V，总能量为0。于是 φa=-10V而非-20V，场强为200V/m，a 点电子电势能10eV，且任意时刻 Ep=-Ek。本题原卷虽标为多选，但按题干“不正确的是”逐项核算后只有 A 不正确。"
    },
    {
      "stepId": 4,
      "title": "结论",
      "content": "答案为 **A**。"
    }
  ],
