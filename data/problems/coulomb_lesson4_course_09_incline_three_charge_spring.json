  "title": "例9：斜面三球与弹簧",
  "type": "multiple-choice",
  "question": "光滑绝缘斜面上 A、B、C 等质量、等间距静止，A 连弹簧，q_A=q_0>0、q_B=-q_0。判断 q_C、弹簧伸长量、A 受库仑力及间距。",
  "options": [
    "A. \\(q_C=4q_0/7\\)",
    "B. 弹簧伸长量为 \\(mg\\sin\\alpha/k_0\\)",
    "C. A 球所受库仑力大小为 2mg",
    "D. 相邻球间距为 \\(q_0\\sqrt{3k/(7mg\\sin\\alpha)}\\)"
  ],
  "answer": "AD",
  "analysis": {
    "title": "解析",
    "sharedThinking": "先用不受弹簧的 B、C 两球沿斜面平衡，求电荷和间距，再回到 A 球。",
    "sharedFormula": "\\[\\frac{kq_0^2}{l^2}=\\frac73mg\\sin\\alpha\\]"
  },
  "analysisPresentation": {
    "collapseEachStep": true,
    "optionMode": "independent-statements"
  },
